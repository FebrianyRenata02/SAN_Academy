<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <!-- Favicon Logo di Tab Browser -->
    <link rel="icon" type="image/png" href="https://raw.githubusercontent.com/FebrianyRenata02/SAN_Academy/refs/heads/main/src/img/SAN-Academy-bg-putih.png">
    <!-- Tailwind CSS & FontAwesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-[#0f0b1e] text-gray-100 font-sans antialiased">

    <div class="flex h-screen overflow-hidden">

        <!-- SIDEBAR KIRI: Table of Contents -->
        <aside class="w-80 bg-[#16102a] border-r border-[#261c44] flex flex-col z-10">
            <div class="p-4 border-b border-[#261c44] flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <!-- Logo menggunakan link GitHub mentah -->
                    <img src="https://raw.githubusercontent.com/FebrianyRenata02/SAN_Academy/refs/heads/main/src/img/SAN-Academy-bg-putih.png" alt="SAN Academy Logo" class="w-8 h-8 rounded-lg object-contain bg-[#1f1638] p-0.5 border border-[#3b2b63]">
                    <span class="font-bold text-lg text-purple-400 tracking-wide">SAN <span class="text-white">Academy</span></span>
                </div>
                <button class="text-gray-400 hover:text-white transition"><i class="fa-solid fa-gear"></i></button>
            </div>

            <div class="flex-1 overflow-y-auto p-4 space-y-4">
                <h2 class="text-xs font-bold text-gray-500 uppercase tracking-wider">Table of Contents</h2>
                <div class="space-y-1">
                    <div class="text-sm font-semibold text-gray-400 mb-2">Pengenalan & Sejarah Komputer</div>

                    <% lessons.forEach(item => { %>
                        <a href="/?lesson=<%= item.id %>" class="flex items-center justify-between p-3 rounded-lg <%= item.title === currentLesson.title ? 'bg-purple-600 text-white shadow-md shadow-purple-900/50' : 'hover:bg-[#1f1638] text-gray-300' %> transition">
                            <div class="flex items-center space-x-3">
                                <i class="fa-solid fa-play text-xs"></i>
                                <div>
                                    <p class="text-sm font-medium">
                                        <%= item.title %>
                                    </p>
                                    <p class="text-xs <%= item.title === currentLesson.title ? 'text-purple-200' : 'text-gray-500' %>">
                                        <%= item.duration %>
                                    </p>
                                </div>
                            </div>
                            <% if(item.completed) { %>
                                <span class="text-xs <%= item.title === currentLesson.title ? 'bg-purple-700 text-white' : 'bg-[#261c44] text-purple-300' %> px-2 py-0.5 rounded font-medium">Selesai</span>
                                <% } %>
                        </a>
                        <% }) %>
                </div>
            </div>
        </aside>

        <!-- KONTEN UTAMA -->
        <main class="flex-1 flex flex-col h-full overflow-y-auto bg-[#0f0b1e]">

            <header class="bg-[#16102a] border-b border-[#261c44] px-6 py-4 flex items-center justify-between">
                <div class="flex items-center space-x-4">
                    <h1 class="text-lg font-semibold text-white">
                        <%= currentLesson.title %>
                    </h1>
                </div>
                <div class="flex items-center space-x-6 text-sm">
                    <span class="text-purple-400 font-semibold border-b-2 border-purple-500 pb-1"><i class="fa-solid fa-video mr-1"></i> Materi</span>
                    <span class="text-gray-400 hover:text-white cursor-pointer">Questions</span>
                    <span class="text-gray-400 hover:text-white cursor-pointer">Notes</span>
                </div>
            </header>

            <!-- Grid Tengah: Video (Kiri) & Layar/PPT (Kanan) -->
            <div class="p-6 grid grid-cols-1 lg:grid-cols-2 gap-6 bg-[#0f0b1e]">

                <!-- Sisi Kiri: Video Player -->
                <div class="bg-black rounded-xl overflow-hidden shadow-lg border border-[#261c44] flex flex-col justify-between relative aspect-video">
                    <div class="absolute inset-flex items-center justify-center w-full h-full">
                        <button class="w-14 h-14 bg-purple-600 rounded-full flex items-center justify-center text-white shadow-lg hover:bg-purple-500 transition">
                            <i class="fa-solid fa-play text-xl ml-1"></i>
                        </button>
                    </div>
                    <div class="z-10 bg-gradient-to-t from-black/90 to-transparent p-4 mt-auto flex items-center justify-between text-white text-xs">
                        <div class="flex items-center space-x-3">
                            <i class="fa-solid fa-play cursor-pointer hover:text-purple-400"></i>
                            <i class="fa-solid fa-rotate-left cursor-pointer hover:text-purple-400"></i>
                        </div>
                        <div>00:00 /
                            <%= currentLesson.duration %>
                        </div>
                    </div>
                </div>

                <!-- Sisi Kanan: Layar / Slide PPT Interaktif -->
                <div class="bg-[#16102a] rounded-xl border border-[#261c44] overflow-hidden shadow-sm flex flex-col aspect-video">
                    <div class="bg-[#120c22] px-4 py-2 border-b border-[#261c44] flex items-center space-x-2">
                        <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                        <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                        <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                        <span class="text-xs text-gray-400 ml-2">https://Pengenalan-dan-Sejarah.com</span>
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-center items-center text-center bg-[#16102a] text-white">
                        <h3 class="text-xl font-bold mb-2 text-purple-400">Interactive Slide / PPT</h3>
                        <p class="text-sm text-gray-400">Menampilkan materi visual atau slide presentasi terkait topik.</p>
                    </div>
                </div>

            </div>

            <!-- Bagian Bawah: Ringkasan Materi -->
            <div class="p-6 bg-[#16102a] border border-[#261c44] mx-6 mb-6 rounded-xl shadow-sm">
                <h3 class="text-base font-bold text-white mb-3"><i class="fa-solid fa-book-open text-purple-400 mr-2"></i> Ringkasan Materi</h3>
                <p class="text-sm text-gray-300 leading-relaxed">
                    <%= currentLesson.summary %>
                </p>
            </div>

        </main>
    </div>

</body>

</html>
